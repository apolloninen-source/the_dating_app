{
  "schema_version": "0.8.0",
  "description": "Categorical dealbreaker and social-expectation questions. Each person answers `self` and may set `accept` (the partner answers they accept). Strictness is fuzzy: 1 when the person marks the question strict, otherwise the degree to which their linked hard-constraint rating is high, and at least matching_config.fuzzy.baseline_strictness; a mismatch lowers the constraint satisfaction by that degree. Questions with `compatibility` use it as a soft default `accept` when the person set none. `prefer_not_to_say` and unanswered count as mostly unknown (fuzzy.unknown_mismatch).",
  "question_types": {
    "single_choice": "Exactly one option for `self`; `accept` is a list of option ids.",
    "multi_choice": "One or more options for `self`; passes when any of them is in `accept`.",
    "language_overlap": "Uses profile.languages; when enabled, passes only if the two people share at least one language at conversational level or better.",
    "location": "Uses profile.location, max_distance_km, open_to_long_distance and countries_open."
  },
  "visibility_levels": {
    "profile": "Shown on the profile.",
    "match_only": "Shown only after a mutual match.",
    "private": "Never shown to anyone; used for filtering only."
  },
  "prefer_not_to_say_option": "prefer_not_to_say",
